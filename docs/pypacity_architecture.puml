@startuml
skinparam classAttributeIconSize 0

class Cable {
  +Cstring: str
  +D: float
  +D1: float
  +d: float
  +TLO: float
  +THI: float
  +TCDRMAX: float
  +RLO: float
  +RHI: float
  +EMISS: float
  +ABSORP: float
  +HNH: int
  +lambda_ertc: float
  +load_cable_db()
  +set_cable(NSELECT, conductor)
}

class Case {
  +NSELECT: int
  +TT: int
  +DELTIME: int
  +TCDRPRELOAD: float
  +XIPRELOAD: float
  +XISTEP: float
  +TAMB: float
  +VWIND: float
  +WINDANG_DEG: float
  +CDR_ELEV: float
  +CDR_LAT_DEG: float
  +NDAY: int
  +SUN_TIME: float
  +SOLAR: int
  +SolarRadiation: float
}

class IEEE738 {
  +Cable1: Cable
  +Case1: Case
  +Debug: int
  +Debug_Dec: int
  +set_cable(Cable)
  +set_case(Case)
  +ieee_738_2013()
  +solar()
  +thermal()
  +thermal_rating()
  +TCDR_vs_TIME()
}

class CIGRE601 {
  +Cable1: Cable
  +Case1: Case
  +Debug: int
  +Tolerance: float
  +MaxIterations: int
  +error: int
  +set_cable(Cable)
  +set_case(Case)
  +set_error(error)
  +get_error()
  +solar()
  +sind(angle)
  +cosd(angle)
}

class PVSystems {
  +version: str
  +vdate: str
  +Gsc: float
  +Location: str
  +Country: str
  +Lat: float
  +Lon: float
  +Gon(day)
  +DayOfYear(day, month)
  +Declination(day)
  +LongStd()
  +ET(dayofyear)
  +HMtoStandardTime(...)
}

Cable "1" <-- "1" IEEE738 : usa
Case  "1" <-- "1" IEEE738 : usa

Cable "1" <-- "1" CIGRE601 : usa
Case  "1" <-- "1" CIGRE601 : usa

PVSystems ..> Case : aporta cálculos solares

IEEE738 ..> "IEEE Std 738" : implementa
CIGRE601 ..> "CIGRE TB601" : implementa

@enduml